{
  "name": "dsh-subagent-concurrency-limit",
  "version": "0.1.1",
  "description": "Limit concurrent DeepSeek Harness subagent turns and delegation runs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blauerberg/dsh-subagent-concurrency-limit.git"
  },
  "homepage": "https://github.com/blauerberg/dsh-subagent-concurrency-limit#readme",
  "bugs": {
    "url": "https://github.com/blauerberg/dsh-subagent-concurrency-limit/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "subagent",
    "concurrency"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./pause": {
      "types": "./lib/pause.d.ts",
      "default": "./lib/pause.js"
    },
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "biome format --write",
    "lint": "biome ci",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.contract.json",
    "test": "node --test tests/*.spec.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run check"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": ">=11.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-subagent": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.22.0"
}
